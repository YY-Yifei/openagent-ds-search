# 复制成 .env 或按需 export。本项目只读环境变量，不自动加载 .env。
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 用真名：deepseek-chat / deepseek-reasoner 会被服务端静默路由到 deepseek-flash
DEEPSEEK_MODEL=deepseek-flash
# 上下文窗口：默认 1048576（服务端 /models 自报的 1M）；要十进制 1M 就写 1000000
# DEEPSEEK_CONTEXT_SIZE=1048576
OPENAGENT_STREAM=1

# 两个工具（search / fetch）共用同一套重试与超时。
# 新名字优先；旧名 DS_SEARCH_* 仍然兼容（免得老 .env 静默失效）。
DS_TOOLS_RETRIES=2
DS_TOOLS_TIMEOUT=30

# 只想让模型少要几条结果时用（0 = 不限制）
DS_SEARCH_MAX_COUNT=0
